post_install() {
	cat <<-EOF
	cmmrs needs your user in the 'i2c' group to talk to /dev/i2c-*
	without sudo (the native DDC/CI backend needs this regardless of
	whether ddcutil is installed):

	    sudo usermod -aG i2c "\$USER"

	Log out and back in for the group change to take effect. Falls
	back to the 'ddcutil' package automatically if that's installed
	and the native backend finds nothing (e.g. permissions).
	EOF
}

post_upgrade() {
	post_install
}
