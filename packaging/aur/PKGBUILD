# Maintainer: Kaue Pereira <kauefontes@outlook.com>
pkgname=cmmrs
pkgver=0.1.0
pkgrel=1
pkgdesc="A terminal UI for controlling DDC/CI monitors, vendor-agnostic"
arch=('x86_64' 'aarch64')
url="https://github.com/kauefontes/cmmrs"
license=('MIT')
depends=('gcc-libs')
optdepends=('ddcutil: fallback DDC/CI backend used when the native /dev/i2c-* backend finds nothing')
makedepends=('cargo')
source=("$pkgname-$pkgver.crate::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
sha256sums=('10f5ddf8b3e9e84d86d4d6b156a2af9d9778c3bf36661a0e669dfc0b771746cb')
install=cmmrs.install

prepare() {
	cd "$pkgname-$pkgver"
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release
}

check() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	cargo test --frozen --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm0755 "target/release/$pkgname" -t "$pkgdir/usr/bin/"
	install -Dm0644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
	install -Dm0644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
